{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anet-drone.dev/vehicle/1/ground_catalog.schema.json",
  "title": "awr.device_catalog.ground.v1 (ground vehicle catalog)",
  "description": "`vehicles/ground/catalog.json`: the ground vehicle packages the device ladder and the unified L2 engine know about. Kept apart from the air catalog (awr.vehicle_catalog.v1) so that the sandbox's nest, mission and UI machinery, which is multirotor- and fixed-wing-specific, is untouched; the device ladder joins both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_version", "disclaimer_zh", "models"],
  "properties": {
    "schema": {"const": "awr.device_catalog.ground.v1"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "disclaimer_zh": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dir", "profile_version", "display_name", "display_name_zh", "category", "size_class", "reference", "visible", "summary_zh"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"},
          "dir": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"},
          "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "display_name": {"type": "string", "minLength": 1},
          "display_name_zh": {"type": "string", "minLength": 1},
          "category": {"const": "ugv"},
          "size_class": {"enum": ["small", "medium", "large"]},
          "reference": {"type": "boolean", "description": "true: a generic reference vehicle (all values D unless sourced); false: modelled on a named public platform"},
          "visible": {"type": "boolean"},
          "order": {"type": "integer", "minimum": 0},
          "summary_zh": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
